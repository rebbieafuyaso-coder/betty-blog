---
import '../styles.css'

export interface Props {
  title: string;
  description?: string;
  image?: string; // <-- Added for dynamic social sharing images
  activePage?: 'home' | 'blog' | 'about' | 'categories' | 'contact';
}

const { 
  title, 
  description = 'BettyWakiaBlog — stories, ideas, and books.', 
  image, // <-- Destructured
  activePage 
} = Astro.props;

const nav = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/blog', label: 'Blog', id: 'blog' },
  { href: '/categories', label: 'Categories', id: 'categories' },
  { href: '/about', label: 'About', id: 'about' },
  { href: '/contact', label: 'Contact', id: 'contact' },
];

// TODO: replace with Betty's real profile URLs
const LINKEDIN_URL = 'https://www.linkedin.com/in/REPLACE-ME';
const FACEBOOK_URL = 'https://www.facebook.com/REPLACE-ME';
const BRAND_NAME = 'BettyWakiaBlog';

// Domain & Social Image Logic
const DOMAIN = 'https://bettywakiablog.com';
const defaultImage = `${DOMAIN}/og-image.jpg`; 
// Create absolute URL for the image if one is passed
const metaImage = image ? new URL(image, DOMAIN).toString() : defaultImage;
// Create absolute canonical URL
const canonicalURL = new URL(Astro.url.pathname, DOMAIN);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:site_name" content={BRAND_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />

    <!-- Favicon & Fonts -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="banner">STORIES · IDEAS · BOOKS — BETTYWAKIABLOG</div>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand"><span class="brand-mark grad"></span>{BRAND_NAME}</a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
          <span class="hamburger-icon"><span></span><span></span><span></span></span>
        </label>

        <nav class="site-nav">
          {nav.map(({ href, label, id }) => (
            <a href={href} class:list={{ active: activePage === id }}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="gutter">
      <div class="footer-grid">
        <div>
          <p class="footer-head">NAVIGATE</p>
          {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
        </div>
        <div>
          <p class="footer-head">LEGAL</p>
          <p>Terms & Conditions</p>
          <p>Privacy Policy</p>
          <p>Accessibility Statement</p>
        </div>
        <div></div>
        <div>
          <p class="footer-head">FOLLOW</p>
          <div class="socials">
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
            <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-logo">BettyWakia.</p>
        <p class="copyright">© {new Date().getFullYear()} {BRAND_NAME}. Built by Rebbie Afuyaso.</p>
      </div>
    </footer>
  </body>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BettyWakiaBlog",
      "url": "https://bettywakiablog.com"
    }
  </script>
</html>

<style is:global>
  :root {
    /* Flag Colors Extracted */
    --flag-yellow: #fcd116;
    --flag-green: #009e49;
    --flag-red: #ce1126;
    --flag-blue: #0072ce;
    --flag-black: #000000;
    --flag-white: #ffffff;

    /* Theme Mappings */
    --dark: var(--flag-black);
    --ink: #111827; 
    --muted: #4b5563;
    --blue-deep: #003a6b; /* Darker blue for readable footer */
    --blue: var(--flag-blue);
    --teal: var(--flag-blue); /* Using flag blue for links/highlights */
    --green: var(--flag-green);
    --mint: #e0f2fe; 
    --yellow: var(--flag-yellow);
  }
  
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    background: #fff;
    color-scheme: light;
  }
  body {
    font-family: 'Wix Madefor Text', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    color: var(--dark);
    line-height: 1.5;
    overflow-x: hidden;
  }

  /* Neutralize the Keystatic starter's narrow column wrapper */
  body > main,
  body > div:not(.banner):not(.site-header):not(.hero):not(.featured):not(.categories):not(.latest):not(.about-strip):not(.cta):not(footer) {
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }

  /* Utilities used by the homepage */
  .gutter { padding-inline: max(24px, calc((100vw - 1280px) / 2 + 24px)); }
  
  /* Updated Gradients using Flag Colors */
  .grad {
    background: linear-gradient(135deg, var(--flag-blue) 0%, var(--flag-green) 50%, var(--flag-yellow) 100%);
    color: #fff;
  }
  .g0 { background: var(--flag-yellow); color: var(--flag-black); }
  .g1 { background: var(--flag-green); color: var(--flag-white); }
  .g2 { background: var(--flag-blue); color: var(--flag-white); }
  .g3 { background: var(--flag-red); color: var(--flag-white); }
  
  .ph { border-radius: 6px; overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  
  .kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; opacity: 0.85; }
  .btn { display: inline-block; border-radius: 24px; padding: 13px 30px; font-size: 14px; font-weight: 600; }
  .empty { text-align: center; padding: 80px 0; opacity: 0.4; font-size: 18px; }

  /* Promo banner */
  .banner {
    background: var(--flag-black);
    color: var(--flag-yellow);
    text-align: center;
    padding: 12px 24px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  /* Header + nav */
  .site-header { background: #fff; border-bottom: 2px solid var(--flag-black); position: sticky; top: 0; z-index: 100; }
  .header-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 24px; height: 72px;
    display: flex; align-items: center; gap: 24px; position: relative;
  }
  .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; font-weight: 700; font-size: 15px; }
  .brand-mark { width: 36px; height: 36px; border-radius: 50%; }
  .site-nav { display: flex; gap: 28px; flex: 1; justify-content: flex-end; }
  .site-nav a { font-size: 14px; opacity: 0.8; }
  .site-nav a.active { opacity: 1; font-weight: 700; color: var(--flag-red); }

  /* Hamburger */
  .nav-toggle-input { display: none; }
  .nav-toggle-label {
    display: none; align-items: center; justify-content: center;
    width: 40px; height: 40px; cursor: pointer; margin-left: auto; flex-shrink: 0;
  }
  .hamburger-icon { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 22px; }
  .hamburger-icon span { height: 2px; background: var(--dark); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
  .nav-toggle-input:checked ~ .nav-toggle-label span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle-input:checked ~ .nav-toggle-label span:nth-child(2) { opacity: 0; }
  .nav-toggle-input:checked ~ .nav-toggle-label span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Footer */
  footer { background: var(--flag-black); color: #fff; padding-top: 60px; border-top: 4px solid var(--flag-green); }
  .footer-head { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; color: var(--flag-yellow); margin-bottom: 16px; }
  .footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; padding-bottom: 60px; }
  .footer-grid a, .footer-grid p:not(.footer-head) { display: block; font-size: 14px; margin-bottom: 10px; color: #d1d5db; }
  .socials { display: flex; gap: 16px; }
  .socials a {
    width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid #4b5563;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .socials a:hover { background: var(--flag-red); border-color: var(--flag-red); transform: translateY(-1px); }
  .footer-bottom { border-top: 1px solid #374151; padding: 48px 0 32px; text-align: center; }
  .footer-logo {
    font-size: clamp(60px, 11vw, 150px); font-weight: 800; line-height: 0.9; letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--flag-yellow), var(--flag-green), var(--flag-red));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .copyright { margin: 40px 0 32px; font-size: 13px; color: #9ca3af; }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 768px) {
    .nav-toggle-label { display: flex; }
    .site-nav {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; gap: 4px; background: #fff;
      border-bottom: 2px solid var(--flag-black); padding: 16px 24px;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
    }
    .site-nav a { padding: 10px 0; width: 100%; }
    .nav-toggle-input:checked ~ .site-nav { display: flex; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>