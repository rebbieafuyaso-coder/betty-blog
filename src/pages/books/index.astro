---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const books = await getCollection('books');
const sorted = books.sort((a, b) =>
  new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);
---

<Layout title="Books | BettyWakiaBlog" description="Books by Betty Wakia." activePage="categories">
  <section class="header gutter">
    <p class="kicker">LIBRARY</p>
    <h1>Books</h1>
    <p class="sub">Published works, with links to read or purchase.</p>
  </section>

  <section class="grid-section gutter">
    <div class="book-grid">
      {sorted.map((book) => (
        <a href={`/books/${book.id}`} class="book-card">
          {book.data.cover && (
            <div class="book-cover">
              <img src={book.data.cover} alt={book.data.title} loading="lazy" />
            </div>
          )}
          <div class="book-info">
            <h2>{book.data.title}</h2>
            <p class="blurb">{book.data.blurb}</p>
            <span class="read-more">View details →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .header { padding-block: 80px 40px; text-align: center; border-bottom: 1px solid #e5e7eb; }
  .header .kicker { color: var(--flag-red); font-weight: 700; letter-spacing: 0.1em; margin-bottom: 12px; }
  .header h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 600; color: var(--ink); }
  .header .sub { font-size: 18px; color: var(--muted); }

  .grid-section { padding-block: 60px 100px; }
  .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px; max-width: 1100px; margin: 0 auto; }
  .book-card { display: flex; flex-direction: column; text-decoration: none; transition: transform 0.2s ease; }
  .book-card:hover { transform: translateY(-4px); }
  .book-cover { aspect-ratio: 2 / 3; border-radius: 8px; overflow: hidden; background: #f3f4f6; margin-bottom: 16px; box-shadow: 0 10px 24px rgba(0,0,0,0.1); }
  .book-cover img { width: 100%; height: 100%; object-fit: cover; }
  .book-info h2 { font-size: 20px; font-weight: 600; color: var(--ink); margin-bottom: 8px; }
  .book-info .blurb { font-size: 14px; line-height: 1.6; color: var(--muted); margin-bottom: 12px; }
  .read-more { font-weight: 600; color: var(--flag-blue); font-size: 14px; }
</style>