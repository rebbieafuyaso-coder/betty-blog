---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const papers = await getCollection('research');
const sorted = papers.sort((a, b) =>
  new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);
---

<Layout title="Research | BettyWakiaBlog" description="Research publications by Betty Wakia." activePage="categories">
  <section class="header gutter">
    <p class="kicker">RESEARCH</p>
    <h1>Publications</h1>
    <p class="sub">Summaries and download links for published papers.</p>
  </section>

  <section class="list gutter">
    {sorted.map((paper) => (
      <a href={`/research/${paper.id}`} class="paper-card">
        {paper.data.cover && (
          <div class="paper-thumb">
            <img src={paper.data.cover} alt={paper.data.title} loading="lazy" />
          </div>
        )}
        <div class="paper-info">
          <h2>{paper.data.title}</h2>
          <p class="summary">{paper.data.summary}</p>
          <span class="read-more">Read summary & download →</span>
        </div>
      </a>
    ))}
  </section>
</Layout>

<style>
  .header { padding-block: 80px 40px; text-align: center; border-bottom: 1px solid #e5e7eb; }
  .header .kicker { color: var(--flag-red); font-weight: 700; letter-spacing: 0.1em; margin-bottom: 12px; }
  .header h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 600; color: var(--ink); }
  .header .sub { font-size: 18px; color: var(--muted); }
  .list { padding-block: 60px 100px; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; }
  .paper-card { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding: 24px; border: 1px solid #e5e7eb; border-radius: 12px; text-decoration: none; transition: box-shadow 0.2s ease; }
  .paper-card:hover { box-shadow: 0 10px 24px rgba(0,0,0,0.08); }
  .paper-thumb { aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; background: #f3f4f6; }
  .paper-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .paper-info h2 { font-size: 20px; font-weight: 600; color: var(--ink); margin-bottom: 8px; }
  .paper-info .summary { font-size: 14px; line-height: 1.6; color: var(--muted); margin-bottom: 12px; }
  .read-more { font-weight: 600; color: var(--flag-blue); font-size: 14px; }
  @media (max-width: 640px) { .paper-card { grid-template-columns: 1fr; } }
</style>