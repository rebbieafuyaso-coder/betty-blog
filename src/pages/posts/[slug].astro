---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const post = await getEntry('articles', slug);

if (!post) throw new Error(`No post found for this slug: ${slug}`);
const { Content } = await render(post);

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map(post => ({ params: { slug: post.id } }));
}

const fmt = (d?: Date | string) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const cover = post.data.cover ?? null;
const category = post.data.category ?? null;
---

<Layout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  image={cover ?? undefined}
  activePage="blog"
>
  <!-- HERO COVER -->
  {cover && (
    <div class="hero-image">
      <img src={cover} alt={post.data.title} />
    </div>
  )}

  <article class:list={{ 'no-cover': !cover }}>
    <p class="kicker">
      {category && <span class="category">{category}</span>}
      {post.data.pubDate && <span>{fmt(post.data.pubDate)}</span>}
    </p>

    <h1>{post.data.title}</h1>

    {post.data.description && <p class="excerpt">{post.data.description}</p>}

    <div class="content">
      <Content />
    </div>

    <!-- SHARE & LIKE ACTIONS -->
    <div class="share-actions">
      <div class="like-section">
        <button id="like-btn" class="action-btn like-btn" aria-label="Like this post">
          <svg class="heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span id="like-text">Like this post</span>
        </button>
      </div>

      <div class="share-section">
        <button id="share-btn" class="action-btn share-btn" aria-label="Share this post">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span id="share-text">Share</span>
        </button>
      </div>
    </div>
  </article>

  <p class="back"><a href="/blog" class="btn btn-ghost">← Back to Blog</a></p>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const likeBtn = document.getElementById('like-btn');
    const likeText = document.getElementById('like-text');
    const shareBtn = document.getElementById('share-btn');
    const shareText = document.getElementById('share-text');
    
    if (!likeBtn || !shareBtn) return;

    // --- LIKE FUNCTIONALITY ---
    const postSlug = window.location.pathname;
    const likeKey = `liked_${postSlug}`;
    
    // Check if already liked on load
    if (localStorage.getItem(likeKey) === 'true') {
      likeBtn.classList.add('liked');
      if (likeText) likeText.textContent = 'Liked!';
    }

    likeBtn.addEventListener('click', () => {
      const isLiked = likeBtn.classList.toggle('liked');
      localStorage.setItem(likeKey, isLiked ? 'true' : 'false');
      if (likeText) likeText.textContent = isLiked ? 'Liked!' : 'Like this post';
    });

    // --- SHARE FUNCTIONALITY ---
    shareBtn.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        text: document.querySelector('meta[name="description"]')?.getAttribute('content') || document.title,
        url: window.location.href,
      };

      // Check if Web Share API is supported (mostly mobile)
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (err) {
          console.log('Error sharing:', err);
        }
      } else {
        // Fallback: Copy to clipboard
        try {
          await navigator.clipboard.writeText(shareData.url);
          if (shareText) shareText.textContent = 'Copied!';
          setTimeout(() => {
            if (shareText) shareText.textContent = 'Share';
          }, 2000);
        } catch (err) {
          console.log('Clipboard error:', err);
        }
      }
    });
  });
</script>

<style>
  .hero-image { height: 480px; overflow: hidden; background: var(--flag-black); }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; object-position: center; }

  article {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px 24px 40px;
  }
  
  article.no-cover { padding-top: 100px; }

  .kicker {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 22px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kicker .category {
    color: var(--flag-white);
    background: var(--flag-red);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
  }

  h1 {
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 28px;
  }

  .excerpt {
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid #e5e7eb;
  }

  .content :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink);
    margin-bottom: 22px;
  }
  .content :global(h2) {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 48px 0 16px;
    color: var(--ink);
  }
  .content :global(h3) {
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 600;
    margin: 36px 0 12px;
    color: var(--ink);
  }
  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 22px 24px;
    font-size: 17px;
    line-height: 1.75;
  }
  .content :global(li) { margin-bottom: 8px; }
  .content :global(blockquote) {
    margin: 32px 0;
    padding: 8px 0 8px 24px;
    border-left: 3px solid var(--flag-red);
    font-size: 19px;
    font-style: italic;
    color: var(--muted);
  }
  .content :global(a) { color: var(--flag-blue); text-decoration: underline; font-weight: 500; }
  .content :global(strong) { color: var(--ink); }
  .content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: #f4f7fa;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .content :global(pre) {
    background: var(--flag-black);
    color: var(--flag-yellow);
    padding: 20px;
    border-radius: 10px;
    overflow-x: auto;
    margin-bottom: 22px;
    font-size: 14px;
    line-height: 1.5;
  }
  .content :global(pre code) { background: transparent; padding: 0; color: inherit; }

  .content :global(img) {
    max-width: 100%;
    height: auto !important;
    display: block;
    margin: 40px auto;
    border-radius: 8px;
  }

  /* --- NEW SHARE ACTIONS STYLES --- */
  .share-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid #e5e7eb;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 999px;
    border: 2px solid #e5e7eb;
    background: #fff;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .action-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Hover states */
  .action-btn:hover {
    border-color: var(--flag-blue);
    color: var(--flag-blue);
    background: #f0f9ff;
  }

  /* Liked state */
  .like-btn.liked {
    color: var(--flag-red);
    border-color: var(--flag-red);
    background: #fef2f2;
  }

  .like-btn.liked svg {
    fill: var(--flag-red);
    stroke: var(--flag-red);
  }

  .back { text-align: center; padding-bottom: 80px; }

  @media (max-width: 640px) {
    .share-actions {
      flex-direction: column;
      gap: 16px;
    }
    .action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>