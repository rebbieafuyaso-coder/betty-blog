---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('articles');
const sorted = [...posts].sort((a, b) =>
  new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);

const fmt = (d?: Date | string) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<Layout
  title="Blog | BettyWakiaBlog"
  description="Read the latest essays, research notes, and stories by Betty Wakia."
  activePage="blog"
>
  <section class="blog-header gutter">
    <p class="kicker">THE JOURNAL</p>
    <h1>All Posts</h1>
    <p class="sub">Essays, research, and stories. Search below to find exactly what you're looking for.</p>
    
    <!-- Search Bar -->
    <div class="search-container">
      <input 
        type="text" 
        id="search-input" 
        placeholder="Search by title, description, or category..." 
        aria-label="Search posts"
      />
    </div>
  </section>

  <section class="blog-list gutter">
    {sorted.length === 0 ? (
      <p class="empty">No posts yet — check back soon.</p>
    ) : (
      <div class="post-grid" id="post-grid">
        {sorted.map((post) => (
          <a 
            href={`/posts/${post.id}`} 
            class="post-card" 
            data-title={post.data.title.toLowerCase()} 
            data-desc={(post.data.description ?? '').toLowerCase()} 
            data-cat={(post.data.category ?? '').toLowerCase()}
          >
            <div class="post-media">
              {post.data.cover && <img src={post.data.cover} alt={post.data.title} loading="lazy" />}
            </div>
            <div class="post-content">
              <p class="meta">
                {post.data.category && <span class="cat">{post.data.category}</span>}
                <span>{fmt(post.data.pubDate)}</span>
              </p>
              <h2>{post.data.title}</h2>
              {post.data.description && <p class="excerpt">{post.data.description}</p>}
            </div>
          </a>
        ))}
      </div>
      <p id="no-results" class="empty" style="display: none;">No posts match your search.</p>
    )}
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const postGrid = document.getElementById('post-grid');
    const noResults = document.getElementById('no-results');
    
    if (!searchInput || !postGrid) return;

    const cards = Array.from(postGrid.querySelectorAll('.post-card')) as HTMLElement[];

    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.dataset.title || '';
        const desc = card.dataset.desc || '';
        const cat = card.dataset.cat || '';

        const match = title.includes(query) || desc.includes(query) || cat.includes(query);
        
        if (match) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });
</script>

<style>
  .blog-header { padding-block: 80px 40px; text-align: center; border-bottom: 1px solid #e5e7eb; }
  .blog-header .kicker { color: var(--flag-red); margin-bottom: 12px; font-weight: 700; letter-spacing: 0.1em; }
  .blog-header h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 600; margin-bottom: 16px; color: var(--ink); }
  .blog-header .sub { font-size: 18px; color: var(--muted); max-width: 600px; margin: 0 auto 32px; }

  .search-container { max-width: 600px; margin: 0 auto; }
  .search-container input {
    width: 100%; padding: 16px 24px; border-radius: 999px;
    border: 2px solid #e5e7eb; font-size: 16px; font-family: inherit;
    outline: none; transition: border-color 0.2s ease;
  }
  .search-container input:focus { border-color: var(--flag-blue); }

  .blog-list { padding-block: 60px 100px; }
  .post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 24px; }
  .post-card { display: block; text-decoration: none; transition: transform 0.2s ease; }
  .post-card:hover { transform: translateY(-4px); }
  .post-media { aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; background: #f3f4f6; margin-bottom: 16px; }
  .post-media img { width: 100%; height: 100%; object-fit: cover; }
  .post-content .meta { display: flex; gap: 12px; font-size: 12px; color: var(--muted); margin-bottom: 8px; align-items: center; }
  .post-content .cat { color: var(--flag-white); background: var(--flag-red); padding: 2px 8px; border-radius: 4px; font-weight: 600; }
  .post-content h2 { font-size: 20px; font-weight: 600; line-height: 1.3; color: var(--ink); margin-bottom: 8px; }
  .post-content .excerpt { font-size: 14px; line-height: 1.6; color: var(--muted); }

  @media (max-width: 900px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .post-grid { grid-template-columns: 1fr; } }
</style>