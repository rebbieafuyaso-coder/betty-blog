---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const posts = await getCollection('articles');
const sorted = [...posts].sort((a, b) =>
  new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);

// Grab the 3 most recent posts for the homepage
const latestPosts = sorted.slice(0, 3);

const fmt = (d?: Date | string) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<Layout
  title="BettyWakiaBlog | Stories, Ideas & Books"
  description="A space for writing, research, and books by Betty Wakia."
  activePage="home"
>
  <!-- HERO SECTION -->
  <section class="hero gutter">
    <div class="hero-inner">
      <p class="kicker">WELCOME TO BETTYWAKIABLOG</p>
      <h1>Stories worth reading.<br />Books worth keeping.</h1>
      <p class="hero-sub">
        Writing, research, and published work — gathered in one calm, welcoming place.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn btn-primary">Explore the Blog</a>
        <a href="/about" class="btn btn-ghost">About Betty</a>
      </div>
    </div>
  </section>

  <!-- LATEST POSTS PREVIEW -->
  <section class="latest gutter">
    <div class="section-head row-head">
      <div>
        <p class="kicker">RECENT</p>
        <h2>Latest posts</h2>
      </div>
      <a href="/blog" class="btn btn-ghost">View all posts →</a>
    </div>
    
    {latestPosts.length === 0 ? (
      <p class="empty">No posts yet — check back soon.</p>
    ) : (
      <div class="post-grid">
        {latestPosts.map((post) => (
          <a href={`/posts/${post.id}`} class="post-card">
            <div class="post-media">
              {post.data.cover && <img src={post.data.cover} alt={post.data.title} loading="lazy" />}
            </div>
            <p class="meta">
              {post.data.category && <span class="cat">{post.data.category}</span>}
              <span>{fmt(post.data.pubDate)}</span>
            </p>
            <h3>{post.data.title}</h3>
            {post.data.description && <p class="excerpt">{post.data.description}</p>}
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  /* Hero Styles */
  .hero {
    padding-block: 100px 80px;
    background:
      radial-gradient(1200px 500px at 10% -10%, rgba(0, 158, 73, 0.15), transparent 60%),
      radial-gradient(900px 400px at 100% 0%, rgba(252, 209, 22, 0.15), transparent 55%),
      #fff;
    border-bottom: 2px solid var(--flag-black);
    text-align: center;
  }
  .hero-inner { max-width: 820px; margin: 0 auto; }
  .hero .kicker { color: var(--flag-red); letter-spacing: 0.14em; margin-bottom: 18px; }
  .hero h1 {
    font-size: clamp(36px, 6.5vw, 76px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 56ch;
    margin-inline: auto;
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.6;
    color: var(--muted);
  }
  .hero-actions { display: flex; gap: 16px; margin-top: 36px; justify-content: center; flex-wrap: wrap; }

  /* Latest Posts Styles */
  .latest { padding-block: 80px; }
  .section-head { margin-bottom: 40px; }
  .section-head h2 { font-size: clamp(24px, 3vw, 36px); font-weight: 600; }
  .section-head .kicker { margin-bottom: 8px; color: var(--flag-blue); }
  .row-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  
  .post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .post-card { display: block; text-decoration: none; transition: transform 0.2s ease; }
  .post-card:hover { transform: translateY(-4px); }
  .post-media { aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; background: #f3f4f6; margin-bottom: 16px; }
  .post-media img { width: 100%; height: 100%; object-fit: cover; }
  .meta { display: flex; gap: 12px; font-size: 12px; color: var(--muted); margin-bottom: 8px; align-items: center; }
  .meta .cat { color: var(--flag-white); background: var(--flag-red); padding: 2px 8px; border-radius: 4px; font-weight: 600; }
  .post-card h3 { font-size: 20px; font-weight: 600; line-height: 1.3; color: var(--ink); margin-bottom: 8px; }
  .post-card .excerpt { font-size: 14px; line-height: 1.6; color: var(--muted); }

  @media (max-width: 900px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .post-grid { grid-template-columns: 1fr; } }
</style>