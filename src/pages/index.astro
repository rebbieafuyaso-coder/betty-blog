---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const posts = await getCollection('posts');

// Newest first
const sorted = [...posts].sort((a, b) =>
  new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);

const featured = sorted[0] ?? null;
const latest = sorted.slice(1, 7);

// Build a simple category map from post data (adjust `category` to your schema field)
const categories = Array.from(
  new Set(sorted.map((p) => p.data.category).filter(Boolean))
).slice(0, 6);

const fmt = (d?: Date | string) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<Layout
  title="BettyWakiaBlog | Stories, Ideas & Books"
  description="A space for writing, research, and books by Betty Wakia."
>
  <!-- HERO -->
  <section class="hero gutter">
    <div class="hero-inner">
      <p class="kicker">BETTYWAKIABLOG</p>
      <h1>Stories worth reading.<br />Books worth keeping.</h1>
      <p class="hero-sub">
        Writing, research, and published work — gathered in one calm, welcoming place.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn btn-primary">Explore Posts</a>
        <a href="/about" class="btn btn-ghost">About Betty</a>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  {featured && (
    <section class="featured gutter">
      <div class="section-head">
        <p class="kicker">FEATURED</p>
        <h2>Latest story</h2>
      </div>
      <a href={`/posts/${featured.id}`} class="featured-card">
        <div class="featured-media">
          {featured.data.cover
            ? <img src={featured.data.cover} alt={featured.data.title} />
            : <div class="ph g0"></div>}
        </div>
        <div class="featured-body">
          <p class="meta">{fmt(featured.data.pubDate)}</p>
          <h3>{featured.data.title}</h3>
          {featured.data.description && <p class="excerpt">{featured.data.description}</p>}
          <span class="read-more">Read the story →</span>
        </div>
      </a>
    </section>
  )}

  <!-- CATEGORIES -->
  {categories.length > 0 && (
    <section class="categories gutter">
      <div class="section-head">
        <p class="kicker">BROWSE</p>
        <h2>Categories</h2>
      </div>
      <div class="cat-grid">
        {categories.map((c, i) => (
          <a href={`/categories/${String(c).toLowerCase()}`} class={`cat-card g${i % 4}`}>
            <span>{c}</span>
            <small>{sorted.filter((p) => p.data.category === c).length} posts</small>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- LATEST POSTS -->
  <section class="latest gutter">
    <div class="section-head row-head">
      <div>
        <p class="kicker">RECENT</p>
        <h2>Latest posts</h2>
      </div>
      <a href="/blog" class="btn btn-ghost">All posts →</a>
    </div>
    {latest.length === 0 ? (
      <p class="empty">No posts yet — check back soon.</p>
    ) : (
      <div class="post-grid">
        {latest.map((post, i) => (
          <a href={`/posts/${post.id}`} class="post-card">
            <div class="post-media">
              {post.data.cover
                ? <img src={post.data.cover} alt={post.data.title} />
                : <div class={`ph g${i % 4}`}></div>}
            </div>
            <p class="meta">{fmt(post.data.pubDate)}</p>
            <h3>{post.data.title}</h3>
            {post.data.description && <p class="excerpt">{post.data.description}</p>}
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- ABOUT STRIP -->
  <section class="about-strip gutter">
    <div class="about-inner">
      <div class="about-media ph g1"></div>
      <div>
        <p class="kicker">ABOUT THE AUTHOR</p>
        <h2>Betty Wakia</h2>
        <p>
          Researcher, writer, and author. BettyWakiaBlog is where her essays,
          research notes, and books come together — for readers who like their
          ideas considered and their writing unhurried.
        </p>
        <a href="/about" class="btn btn-primary">Read her story</a>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER / CTA -->
  <section class="cta gutter">
    <div class="cta-inner">
      <div>
        <p class="kicker">STAY IN TOUCH</p>
        <h2>New essays, straight to your inbox.</h2>
        <p>Occasional notes on new writing, new books, and what Betty is reading.</p>
      </div>
      <form class="cta-form" onsubmit="event.preventDefault();">
        <input type="email" placeholder="you@example.com" aria-label="Email address" required />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Shared bits ---------- */
  .section-head { margin-bottom: 28px; }
  .section-head h2 { font-size: clamp(24px, 3vw, 36px); font-weight: 500; letter-spacing: -0.02em; }
  .section-head .kicker { margin-bottom: 8px; color: var(--teal); }
  .row-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .meta { font-size: 12px; color: var(--muted); margin-bottom: 8px; }
  .excerpt { font-size: 14px; line-height: 1.6; color: var(--muted); }

  /* ---------- HERO ---------- */
  .hero {
    padding-block: 96px 72px;
    background:
      radial-gradient(1200px 500px at 10% -10%, rgba(23,162,168,0.18), transparent 60%),
      radial-gradient(900px 400px at 100% 0%, rgba(47,191,143,0.16), transparent 55%),
      #fff;
    border-bottom: 1px solid #eef2f6;
  }
  .hero-inner { max-width: 820px; }
  .hero .kicker { color: var(--teal); letter-spacing: 0.14em; margin-bottom: 18px; }
  .hero h1 {
    font-size: clamp(36px, 6.5vw, 76px);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 56ch;
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.6;
    color: var(--muted);
  }
  .hero-actions { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }

  /* ---------- Buttons ---------- */
  .btn-primary {
    background: linear-gradient(135deg, var(--blue), var(--teal));
    color: #fff;
    border: none;
  }
  .btn-ghost {
    background: transparent;
    border: 1.5px solid #d6e2ec;
    color: var(--ink);
  }
  .btn-ghost:hover { border-color: var(--teal); color: var(--teal); }

  /* ---------- FEATURED ---------- */
  .featured { padding-block: 72px; }
  .featured-card {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 40px;
    align-items: center;
    background: #fff;
    border: 1px solid #e8eef4;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .featured-card:hover { box-shadow: 0 18px 40px rgba(11,61,107,0.10); transform: translateY(-2px); }
  .featured-media { aspect-ratio: 16 / 10; overflow: hidden; }
  .featured-media img, .featured-media .ph { width: 100%; height: 100%; object-fit: cover; display: block; }
  .featured-body { padding: 32px 36px 32px 0; }
  .featured-body h3 { font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 12px; color: var(--ink); }
  .read-more { display: inline-block; margin-top: 18px; font-weight: 600; color: var(--teal); }

  /* ---------- CATEGORIES ---------- */
  .categories { padding-block: 24px 72px; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .cat-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 132px;
    padding: 18px 20px;
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cat-card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(11,61,107,0.18); }
  .cat-card span { font-weight: 600; font-size: 17px; }
  .cat-card small { opacity: 0.85; font-size: 12px; margin-top: 4px; }

  /* ---------- LATEST ---------- */
  .latest { padding-block: 24px 72px; }
  .post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 24px; }
  .post-card { text-decoration: none; display: block; }
  .post-media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 10px; margin-bottom: 14px; background: #f2f6f9; }
  .post-media img, .post-media .ph { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .post-card:hover .post-media img { transform: scale(1.04); }
  .post-card h3 { font-size: 18px; font-weight: 600; line-height: 1.3; color: var(--ink); margin-bottom: 8px; }

  /* ---------- ABOUT STRIP ---------- */
  .about-strip { padding-block: 72px; background: #f7fafc; border-block: 1px solid #eaf1f6; }
  .about-inner { display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: center; }
  .about-media { aspect-ratio: 1 / 1; border-radius: 14px; }
  .about-inner h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 600; margin: 8px 0 14px; letter-spacing: -0.02em; }
  .about-inner p { color: var(--muted); line-height: 1.7; margin-bottom: 22px; max-width: 52ch; }

  /* ---------- CTA ---------- */
  .cta { padding-block: 72px; }
  .cta-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
    padding: 40px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--blue-deep), var(--blue) 45%, var(--teal) 100%);
    color: #fff;
  }
  .cta-inner h2 { font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; margin: 6px 0 10px; letter-spacing: -0.01em; }
  .cta-inner p { opacity: 0.9; line-height: 1.6; }
  .cta-inner .kicker { color: #bfe9e2; }
  .cta-form { display: flex; gap: 10px; }
  .cta-form input {
    flex: 1;
    padding: 13px 16px;
    border-radius: 24px;
    border: none;
    font-size: 14px;
    outline: none;
  }
  .cta-form .btn-primary { background: #fff; color: var(--blue-deep); }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .featured-card { grid-template-columns: 1fr; }
    .featured-body { padding: 0 24px 28px; }
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .post-grid { grid-template-columns: repeat(2, 1fr); }
    .about-inner { grid-template-columns: 1fr; gap: 28px; }
    .cta-inner { grid-template-columns: 1fr; padding: 28px; }
  }
  @media (max-width: 640px) {
    .hero { padding-block: 56px 48px; }
    .cat-grid, .post-grid { grid-template-columns: 1fr; }
    .cta-form { flex-direction: column; }
    .cta-form input, .cta-form .btn-primary { width: 100%; }
  }
</style>