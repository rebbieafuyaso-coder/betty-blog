---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const articles = await getCollection('articles');
const research = await getCollection('research');
const books = await getCollection('books');

// Helper function to get a random cover image from a collection
function getRandomCover(collection) {
  const withCovers = collection.filter(item => item.data.cover);
  if (withCovers.length === 0) return null;
  const randomIndex = Math.floor(Math.random() * withCovers.length);
  return withCovers[randomIndex].data.cover;
}

const sections = [
  { 
    title: 'Articles & Blogs', 
    count: articles.length, 
    href: '/blog', 
    color: 'g0',
    cover: getRandomCover(articles)
  },
  { 
    title: 'Research Publications', 
    count: research.length, 
    href: '/research', 
    color: 'g1',
    cover: getRandomCover(research)
  },
  { 
    title: 'Books', 
    count: books.length, 
    href: '/books', 
    color: 'g2',
    cover: getRandomCover(books)
  },
];
---

<Layout title="Categories | BettyWakiaBlog" description="Browse all content by type." activePage="categories">
  <section class="header gutter">
    <p class="kicker">BROWSE</p>
    <h1>Explore</h1>
    <p class="sub">Pick a section to start reading.</p>
  </section>

  <!-- Changed from gutter to full-width wrapper -->
  <section class="grid-section">
    <div class="cat-grid gutter">
      {sections.map((s, i) => (
        <a href={s.href} class={`cat-card ${s.color} ${i === 1 ? 'featured' : ''}`}>
          
          <!-- Background Image or Gradient -->
          {s.cover ? (
            <img src={s.cover} alt={s.title} class="cat-bg" loading="lazy" />
          ) : (
            <div class={`cat-bg ${s.color}`}></div>
          )}
          
          <!-- Dark Overlay for readability -->
          <div class="overlay"></div>
          
          <!-- Text Content -->
          <div class="cat-content">
            <span>{s.title}</span>
            <small>{s.count} items</small>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .header { padding-block: 80px 40px; text-align: center; border-bottom: 1px solid #e5e7eb; }
  .header .kicker { color: var(--flag-red); font-weight: 700; letter-spacing: 0.1em; margin-bottom: 12px; }
  .header h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 600; color: var(--ink); }
  .header .sub { font-size: 18px; color: var(--muted); }

  /* Removed max-width to allow full expansion */
  .grid-section { padding-block: 60px 120px; width: 100%; }
  
  .cat-grid { 
    display: grid; 
    /* 1fr 2fr 1fr makes the middle exactly double the sides */
    grid-template-columns: 1fr 2fr 1fr; 
    gap: 32px; 
    align-items: stretch;
    /* The gutter class adds the left/right padding automatically */
  }

  .cat-card { 
    display: flex; 
    flex-direction: column; 
    justify-content: flex-end; 
    /* Increased min-height significantly */
    min-height: 500px; 
    padding: 40px; 
    border-radius: 24px; 
    text-decoration: none; 
    transition: transform 0.3s ease, box-shadow 0.3s ease; 
    position: relative;
    overflow: hidden; 
    background: #000; 
  }

  .cat-card:hover { 
    transform: translateY(-8px); 
    box-shadow: 0 24px 48px rgba(0,0,0,0.25);
  }

  .cat-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    z-index: 1;
  }

  .cat-card:hover .cat-bg {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
    z-index: 2;
  }

  .cat-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cat-card span { 
    font-weight: 700; 
    font-size: clamp(24px, 3vw, 40px);
    color: #fff; 
    line-height: 1.15;
  }

  .cat-card small { 
    color: rgba(255, 255, 255, 0.85); 
    font-size: 16px; 
    font-weight: 500;
  }

  .cat-card.featured span {
    font-size: clamp(36px, 5vw, 64px);
  }

  .cat-card.featured small {
    font-size: 20px;
  }

  /* Responsive */
  @media (max-width: 1024px) { 
    .cat-grid { 
      grid-template-columns: 1fr 1.5fr 1fr; 
      gap: 20px;
    } 
    .cat-card { min-height: 400px; padding: 24px; }
    .cat-card.featured span { font-size: clamp(28px, 4vw, 40px); }
  }

  @media (max-width: 768px) { 
    .cat-grid { 
      grid-template-columns: 1fr; 
      gap: 24px;
    } 
    .cat-card.featured {
      grid-column: 1 / -1;
      min-height: 300px;
    }
    .cat-card { min-height: 280px; }
  }
</style>