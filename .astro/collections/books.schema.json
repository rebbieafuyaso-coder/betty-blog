{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "blurb": {
      "type": "string"
    },
    "purchaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "cover": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "blurb",
    "purchaseUrl"
  ]
}