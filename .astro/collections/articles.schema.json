{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "default": "blog",
      "type": "string",
      "enum": [
        "article",
        "blog"
      ]
    },
    "description": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}